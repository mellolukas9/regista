# Copie para .env e ajuste. Valores abaixo são apenas para desenvolvimento local.

# Postgres (compose de desenvolvimento)
POSTGRES_PASSWORD=dev-superuser-password
REGISTA_OWNER_PASSWORD=dev-owner-password
REGISTA_APP_PASSWORD=dev-app-password

# API: runtime usa regista_app; migrations usam regista_owner
REGISTA_DATABASE_URL=postgresql+asyncpg://regista_app:dev-app-password@localhost:5432/regista
REGISTA_DATABASE_OWNER_URL=postgresql+asyncpg://regista_owner:dev-owner-password@localhost:5432/regista
REGISTA_ENVIRONMENT=dev
REGISTA_LOG_LEVEL=INFO

# Frontend: destino do proxy /api/* (sem o prefixo /api)
API_URL=http://127.0.0.1:8000

# Chave mestra do KeyProvider local (base64, 32 bytes). Obrigatória para a API subir.
# Gere com: uv run python -c "from regista_api.core.keys import LocalKeyProvider; print(LocalKeyProvider.generate_key())"
REGISTA_MASTER_KEY=

# URL do painel (monta os links de convite) e envio de e-mail (dev: imprime no console)
REGISTA_PUBLIC_URL=http://localhost:3000
REGISTA_EMAIL_BACKEND=console
